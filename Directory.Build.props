<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- the packages carry XML documentation. The missing-comment warning is off here, and back on
         for the libraries, whose public API is documented in full. (The SDK derives the
         documentation file name before Directory.Build.targets is read, so this lives here.) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Distaff</Product>
    <Authors>Jeff Nyman</Authors>
    <Copyright>Copyright (c) Jeff Nyman. Portions derived from ScummVM, copyright the ScummVM Team; from Munt, copyright its authors; and from Daventry and Maniacal, copyright Jeff Nyman.</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jeffnyman/distaff</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jeffnyman/distaff</PackageProjectUrl>
    <!-- dotnet pack -p:VersionSuffix=alpha.2 for the next prerelease; an empty suffix is a release -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <!-- nuget.org renders a package's README as Markdown alone, without the HTML the GitHub one
         uses: the packages carry NUGET.md, the same in Markdown, with links that work there -->
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>
    <PackageTags>scumm;loom;lucasfilm;adventure;interpreter;scummvm;retro;games;fm-towns;mt-32</PackageTags>
    <PackageReleaseNotes>First stable release. The libraries' public API is promised from here under semantic versioning: a breaking change waits for a new major version, and each release is checked against the last one published. Nothing in it has changed since 0.2.0-alpha. Plays Loom's three English releases, the DOS EGA, the FM Towns and the DOS VGA CD, from the start to the end, with their sound (the EGA on the PC speaker, PCjr/Tandy, Game Blaster, AdLib or, from your own ROMs, an emulated MT-32; the FM Towns' FM and PCM chips and CD audio; the VGA CD's voices and music), saves that load in ScummVM and ScummVM's that load here, and gives the same output, to the byte, on Windows, Linux and macOS, where it has been played in its window. What it does not do is in the README under Known limitations.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)NUGET.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
