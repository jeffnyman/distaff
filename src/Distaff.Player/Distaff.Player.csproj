<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>distaff</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>Distaff</PackageId>
    <ToolCommandName>distaff</ToolCommandName>
    <!-- a tool installed under a newer runtime should still start -->
    <RollForward>Major</RollForward>
    <Description>Command line player for Loom (DOS EGA, FM Towns, DOS VGA CD): dotnet tool install -g Distaff, then distaff &lt;game folder&gt;.</Description>
    <!-- it carries Distaff.Audio, and so Munt's code -->
    <PackageLicenseExpression>GPL-3.0-or-later AND LGPL-2.1-or-later</PackageLicenseExpression>
    <!-- tools/icon writes it from AppIcon, the drawing the window's icon comes from -->
    <ApplicationIcon>distaff.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- published for a platform (dotnet publish -c Release -r win-x64), the player is one file
       that needs nothing installed: the runtime, SDL3 and the game code inside, trimmed and
       compressed -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- SDL3 ships native libraries for every platform; a desktop player does not need the Android
       and iOS ones, which are most of the package (the path's separator either slash: Windows
       writes a backslash) -->
  <Target Name="DistaffTrimMobileNatives" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^runtimes[\\/](android|ios)'))" />
      <!-- and a release has no symbols, the other projects' included -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'$(DebugType)' == 'none' and '%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Distaff.Scumm\Distaff.Scumm.csproj" />
    <ProjectReference Include="..\Distaff.Audio\Distaff.Audio.csproj" />
    <PackageReference Include="ppy.SDL3-CS" />
  </ItemGroup>
</Project>
