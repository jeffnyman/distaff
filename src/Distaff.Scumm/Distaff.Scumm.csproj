<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>The SCUMM interpreter for Loom (EGA, VGA CD and FM Towns), ported from ScummVM.</Description>
    <!-- optimized in Debug too: the per-pixel drawing is slow unoptimized -->
    <Optimize>true</Optimize>
    <!-- the published release this one must not break: package validation compares the packed
         library with it, and a public member removed or changed since fails the pack. After each
         release, it becomes that release. -->
    <PackageValidationBaselineVersion>0.1.0-alpha</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Distaff.Scumm.Tests" />
  </ItemGroup>
</Project>
