<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Decoders for the CD audio tracks Loom's CD releases play from files: FLAC, and Ogg Vorbis; and the MT-32 emulator, a port of Munt (LGPL 2.1 or later), for the EGA's Roland Upgrade.</Description>
    <!-- Distaff's own code, and Munt's, whose files keep its licence -->
    <PackageLicenseExpression>GPL-3.0-or-later AND LGPL-2.1-or-later</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <!-- the tests drive Munt's synth as its reference harness does -->
    <InternalsVisibleTo Include="Distaff.Scumm.Tests" />
    <ProjectReference Include="..\Distaff.Scumm\Distaff.Scumm.csproj" />
    <PackageReference Include="NVorbis" />
  </ItemGroup>
</Project>
